# Copy to .env.local and fill in with values from your Supabase project:
# Supabase dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key. Safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin of this deployment. Confirmation emails redirect here + /auth/callback.
# Local: http://localhost:3000
# Vercel: NEXT_PUBLIC_SITE_URL=https://gen-ztracking-peach.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA timezone used to resolve "today" everywhere in the app.
# Must match public.app_time_zone() in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Phnom_Penh
